apiVersion: batch/v1
kind: Job
metadata:
  name: <%= it.metadata.name %>-backup-<%= it.metadata.generation ?? it.metadata.resourceVersion %>
  namespace: <%= it.metadata.namespace %>
<%~ include('./_owner-ref', it) %>
spec:
  backoffLimit: 3
  ttlSecondsAfterFinished: 60
  template:
    spec:
<%~ include('./_snapshot-pod', { ...it, containerName: 'backup', scriptCmd: 'tools/backup.sh', includeSnapshotName: false }) %>
