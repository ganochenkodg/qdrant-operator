apiVersion: v1
kind: Service
metadata:
  name: <%= it.metadata.name %>
  namespace: <%= it.metadata.namespace %>
<%~ include('./_owner-ref', it) %>
spec:
  type: <%= it.spec.service %>
  ports:
    - name: http
      port: 6333
      targetPort: 6333
    - name: grpc
      port: 6334
      targetPort: 6334
    - name: p2p
      port: 6335
      targetPort: 6335
  selector:
    clustername: <%= it.metadata.name %>
    component: qdrant
